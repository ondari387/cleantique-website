# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://cleantique.co.ke
# Set to 1 on staging/preview deployments so search engines do not index them
NEXT_PUBLIC_NOINDEX=
# Google Search Console HTML-tag verification code (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# ---- Analytics (defaults are the IDs already used on cleantique.co.ke) ----
NEXT_PUBLIC_GTM_ID=GTM-W6H9BJJW
NEXT_PUBLIC_GA4_ID=G-S8NSBKQZ35
NEXT_PUBLIC_ADS_ID=AW-17497576869
# Google Ads conversion label for quote form submissions (from Google Ads > Conversions)
NEXT_PUBLIC_ADS_LEAD_LABEL=
# Set to 1 if your GTM container already fires GA4 + Ads tags (prevents double counting)
NEXT_PUBLIC_DISABLE_GTAG=
# Set to 1 to load analytics while running `npm run dev`
NEXT_PUBLIC_ANALYTICS_IN_DEV=

# ---- Quote form: storage ----
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres...). Required in production.
DATABASE_URL=

# ---- Quote form: email notifications (resend.com) ----
RESEND_API_KEY=
ENQUIRY_TO=hi@cleantique.co.ke
# Must be on a domain verified in Resend, e.g. website@cleantique.co.ke
ENQUIRY_FROM=Cleantique Website <website@cleantique.co.ke>

# ---- Quote form: spam protection (optional, Cloudflare Turnstile) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Enquiries admin (/admin/enquiries/) ----
ADMIN_USER=
ADMIN_PASSWORD=

# ---- Content editor (/cms/) via GitHub OAuth app ----
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
